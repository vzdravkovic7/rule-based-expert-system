package rules;

import com.ftn.sbnz.model.Korisnik;
import com.ftn.sbnz.model.TreningIntenzitet;
import com.ftn.sbnz.model.PulsEvent;
import com.ftn.sbnz.model.AktivnaSesija;
import com.ftn.sbnz.model.CEPAlarm;
import java.util.Date;

declare PulsEvent
    @role(event)
    @timestamp(timestamp)
    @expires(15m)
end

declare CEPAlarm
    @role(event)
    @expires(10m)
end

rule "IzracunajCiljnuZonuPulsa - Nizak Intenzitet (30-40%)"
    salience 200
    no-loop true
    when
        $k: Korisnik($id: id, maxPuls == 0, pulsUMirovanju > 0)
        TreningIntenzitet(korisnikId == $id, intenzitet == "NIZAK")
    then
        int izracunatMax = (int) Math.round(207 - (0.7 * $k.getGodine()));
        int hrr = izracunatMax - $k.getPulsUMirovanju();
        
        int zonaDonja = (int) Math.round((0.30 * hrr) + $k.getPulsUMirovanju());
        int zonaGornja = (int) Math.round((0.40 * hrr) + $k.getPulsUMirovanju());
        
        modify($k) {
            setMaxPuls(izracunatMax),
            setCiljnaZonaDonja(zonaDonja),
            setCiljnaZonaGornja(zonaGornja)
        }
end

